# Video Portal - configuration template for the Windows Server VPS.
# Copy to C:\VideoPortal\config\.env (install-prerequisites.ps1 does this) and fill in real values there.
# Never commit the real file. This template contains no secrets.

# --- Runtime ---
APP_ENV=production
# Services read this file through VIDEO_PORTAL_ENV_FILE (set in the service definition).
BIND_HOST=127.0.0.1
BIND_PORT=8000
WAITRESS_THREADS=6
UPLOAD_TIMEOUT_SECONDS=300

# --- PostgreSQL (local only; setup-database.ps1 writes the password) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=video_portal
POSTGRES_USER=video_portal
POSTGRES_PASSWORD=
# 4 GB RAM: API holds at most 4+2 connections, worker a handful; role limit is 20.
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2

# --- Private storage (must be absolute and outside the application folder) ---
STORAGE_ROOT=C:\VideoPortal\storage\objects
WORK_ROOT=C:\VideoPortal\storage\temporary
LOG_DIR=C:\VideoPortal\logs
# Upload limit in bytes (200 MB). Keep request_body max_size in the Caddyfile in step.
MAX_UPLOAD_BYTES=200000000
# Refuse new uploads when free disk space would drop below this many bytes (2 GB).
MIN_FREE_BYTES=2000000000

# --- Sign-in ---
# local    = accounts in PostgreSQL (create with: flask --app app.main create-user EMAIL)
# firebase = verify Firebase ID tokens (needs FIREBASE_* below and Google credentials)
AUTH_PROVIDER=local
SESSION_HOURS=12
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# --- FFmpeg worker (3 vCPU: 2 threads for FFmpeg, 1 left for the API) ---
FFMPEG_BIN=C:\VideoPortal\tools\ffmpeg\bin\ffmpeg.exe
FFPROBE_BIN=C:\VideoPortal\tools\ffmpeg\bin\ffprobe.exe
FFMPEG_THREADS=2
TRANSCODE_TIMEOUT_SECONDS=600
WORKER_MEMORY_LIMIT_MB=1536
