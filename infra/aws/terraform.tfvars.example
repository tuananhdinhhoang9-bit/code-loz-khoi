# Sao chép thành terraform.tfvars (đã gitignore) rồi điền giá trị thật. Không đặt secret vào đây.
domain_name = "video.example.com"
region      = "ap-southeast-2"

# Lần apply đầu: để 0 cho đến khi hai image đã được đẩy lên ECR với đúng image_tag.
# api_desired_count    = 0
# worker_desired_count = 0
# image_tag            = "initial"

# Kích thước (ảnh hưởng chi phí)
# db_instance_class = "db.t4g.micro"
# db_engine_version = "17"
# worker_cpu        = 1024
# worker_memory     = 2048

# Chỉ bật khi dọn dẹp sau demo, ngay trước terraform destroy
# skip_final_snapshot  = true
# force_destroy_bucket = true
