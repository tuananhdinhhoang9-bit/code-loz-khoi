# Video Portal - Caddy reverse proxy for a Windows Server VPS.
# Copy to C:\VideoPortal\config\Caddyfile and edit SITE_ADDRESS below.
#
#   Public HTTPS:  replace `localhost` with your domain, e.g.  video.example.com
#                  Requires an A record to this VPS and inbound TCP 80 + 443. Caddy then obtains
#                  and renews a public certificate automatically.
#   No domain yet: keep `localhost`. Caddy uses its own local CA ("tls internal"): browsers on the
#                  server itself can test HTTPS, but this is NOT a publicly trusted certificate.
#
# Only this file's site block is exposed. The API port (8000), PostgreSQL (5432) and the storage
# folders are never proxied or served as files.
{
	# Admin API stays on loopback only.
	admin 127.0.0.1:2019
}

localhost {
	tls internal

	# Uploads: 200 MB plus HTTP framing. Keep in step with MAX_UPLOAD_BYTES in the app config.
	request_body {
		max_size 201MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Everything goes to Waitress on loopback. There is no file_server directive: nothing on disk
	# (including C:\VideoPortal\storage) is ever served directly.
	reverse_proxy 127.0.0.1:8000 {
		# Caddy overwrites X-Forwarded-* itself; values sent by clients are not passed through.
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
		}
	}

	log {
		output file {$VIDEOPORTAL_LOGS:C:\VideoPortal\logs}\caddy-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Signed storage tickets are short-lived capabilities: never write them to the access log.
		format filter {
			wrap json
			fields {
				request>uri query {
					delete ticket
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
